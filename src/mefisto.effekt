module src/mefisto

import random
import result
import tty

import src/nonstdlib


def getPinRepresentation(pin: Int): String / Formatted = {
    val escapes = pin match {
        case 0 => ["\u001b[48;5;196m", "\u001b[38;5;15m"] // Red background, White foreground
        case 1 => ["\u001b[48;5;202m", "\u001b[38;5;0m"]  // Orange background, Black foreground
        case 2 => ["\u001b[48;5;226m", "\u001b[38;5;0m"]  // Yellow background, Black foreground
        case 3 => ["\u001b[48;5;46m", "\u001b[38;5;0m"]   // Green background, Black foreground
        case 4 => ["\u001b[48;5;51m", "\u001b[38;5;0m"]   // Cyan background, Black foreground
        case 5 => ["\u001b[48;5;33m", "\u001b[38;5;15m"]  // Blue background, White foreground
        case 6 => ["\u001b[48;5;93m", "\u001b[38;5;15m"]  // Purple background, White foreground
        case 7 => ["\u001b[48;5;201m", "\u001b[38;5;0m"]  // Magenta background, Black foreground
        case 8 => ["\u001b[48;5;250m", "\u001b[38;5;0m"]  // Light gray background, Black foreground
        case 9 => ["\u001b[48;5;240m", "\u001b[38;5;15m"] // Dark gray background, White foreground
        case _ => Nil()
    }

    if (escapes.nonEmpty && escapes.all{ x => do supportsEscape(x) }) {
        escapes.join("") ++ pin.show ++ "\u001b[0m"
    } else {
        pin.show
    }
}

// Represents a combination of pins, i.e. the secret code or a guess of it.
record Code(
    pins: List[Int]
)

def show(c: Code) = c match {
    case Code(pins) => "[" ++ pins.map{x => x.getPinRepresentation}.join(", ") ++ "]"
}

// Represents the result of a guess:
// -> Number of pins that are in the correct position
// -> Number of pins that have the right color but are placed incorrectly
record GuessResult(
    correctPos: Int,
    incorrectPos: Int
)

def show(gr: GuessResult) = gr match {
    case GuessResult(correctPos, incorrectPos) => bold(green(correctPos.show)) ++ "/" ++ bold(yellow(incorrectPos.show))
}

// Represents the game configuration:
// -> Length of the secret code (number of pins)
// -> Number of colors (different possible pin values)
interface Config {
    def getCodeLength(): Int
    def getNumColors(): Int
}

// Represents the game master:
// -> When a guess is entered, it responds with a GuessResult
// -> It can reveal the hidden code (at game end)
interface GameMaster {
    def guessResult(guess: Code): GuessResult
    def showSecretCode(): String / Formatted
}

// Represents the player:
// -> It can make a guess, based on the given config
// -> The board can be displayed to the player
// -> When the player wins, an action can be triggered (there is no losing in this game. Just not having won *yet*.)
interface Player {
    def makeGuess(): Code / Config
    def showBoard(attempts: List[(Code, GuessResult)]): Unit / Formatted
    def playerWin(code: String, attempts: List[(Code, GuessResult)]): Unit / Formatted
}

// The basic game loop, agnostic of the exact Player, GameMaster or Config implementation.
// This is the high level game routine that needs to be augmented by handlers to play.
def gameLoop(): Unit / { Formatted, Player, GameMaster, Config } = {
    var guesses: List[(Code, GuessResult)] = Nil()

    loop { {l} =>
        do showBoard(guesses.reverse)
        val guess = do makeGuess()
        val result = do guessResult(guess)

        guesses = Cons((guess, result), guesses)

        if (result.correctPos == do getCodeLength()) {
            do playerWin(do showSecretCode(), guesses.reverse)
            l.break()
        }
    }
}

// A `Player` handler that shows the board to STDOUT and reads guesses from STDIN.
def consolePlayer[A] { program: => A / Player }: A = {
    def showBoardConsole(code: String, attempts: List[(Code, GuessResult)]) = {
        println("+----------------------------------------+")
        println("|                                        |")
        println("|   Secret Code:  " ++ code ++  "        |")
        println("|                                        |")
        attempts.foreachIndex { (i, attempt) => attempt match {
            case (guess, result) => println("|     Attempt " ++ (i + 1).show ++ ":  " ++ guess.show ++ " - " ++ result.show ++ "  |")
        }}
        println("|                                        |")
        println("+----------------------------------------+")
    }


    try {
        program()
    } with Player {
        def makeGuess() = resume {
            on[WrongFormat].retry() { msg => { println("Invalid input: " ++ msg) } } {
                print("Please enter your guess: ")
                val guess = Code(readln().split("").map{x => x.toIntWithException()})
                validateCode(guess)
                guess
            }
        }

        def showBoard(attempts: List[(Code, GuessResult)]) = resume {
            showBoardConsole("[ - HIDDEN -  ]", attempts)
        }

        def playerWin(code: String, attempts: List[(Code, GuessResult)]) = resume {
            showBoardConsole(code, attempts)
            println("Congratulations, you won!")
        }
    }
}

// Helper: Computes a `GuessResult` for a given `guess` and secret `code`.
// This is irrelevant to the Mefisto game master, as there is no single secret `code`.
def codeGuessResult(code: Code, guess: Code): GuessResult = {
    var correctPos = 0
    var unmatchedCode = Nil()   // Pins in the code that are NOT at the same position in the guess
    var unmatchedGuess = Nil()  // Pins in the guess that are NOT at the same position in the code

    code.pins.zip(guess.pins).foreach {
        case (c, g) => if (c == g) {
            correctPos += 1
        } else {
            unmatchedCode = Cons(c, unmatchedCode)
            unmatchedGuess = Cons(g, unmatchedGuess)
        }
    }

    val incorrectPos = unmatchedGuess.distinct().foldLeft(0) { (sum, value) =>
        sum + min(unmatchedCode.count(value), unmatchedGuess.count(value))
    }

    GuessResult(correctPos, incorrectPos)
}

// Produces a (uniformly) random code that is allowed according to the game `Config`.
def randomCode(): Code / { random, Config } = {
    var pins = Nil()
    each(0, do getCodeLength()) { i =>
        pins = Cons(randomInt(0, do getNumColors() - 1), pins)
    }
    Code(pins)
}

// Confirms whether the given `code` is valid according to the `Config`, and raises `WrongFormat` if it isn't.
def validateCode(code: Code): Unit / { Config, Exception[WrongFormat] } = {
    val codeLength = code.pins.size
    val expectedCodeLength = do getCodeLength()
    if (codeLength != expectedCodeLength) {
        wrongFormat("Code length " ++ codeLength.show ++ " does not match the expected length of " ++ expectedCodeLength.show ++ "!")
    }

    val expectedColorLimit = do getNumColors() - 1
    if (code.pins.any { x => x < 0 || x > expectedColorLimit }) {
        wrongFormat("Code contains colors outside of valid range from 0 to " ++ expectedColorLimit.show ++ "!")
    }
}

// A `GameMaster` handler that deterministically uses the given `code` as its secret code.
def deterministicGameMaster[A](code: Code) { program: => A / GameMaster }: A / Config = {
    on[WrongFormat].panic {
        validateCode(code)
    }

    try {
        program()
    } with GameMaster {
        def guessResult(guess: Code) = resume(codeGuessResult(code, guess))
        def showSecretCode() = resume { code.show() }
    }
}

// A `GameMaster` handler for (basic) MasterMind: It decides for one random code,
// then deterministically answers based on this code.
def mastermindGameMaster[A] { program: => A / GameMaster }: A / { random, Config } =
    deterministicGameMaster(randomCode()) { program }

// A `GameMaster` for Mefisto: It does not settle for a specific code until it is
// really forced to! Instead, it tries to keep the search space for the player
// as large as possible.
def mefistoGameMaster[A] { program: => A / GameMaster }: A / { Config } = {
    var guesses = Nil[Code]()

    try {
        program()
    } with GameMaster {
        def guessResult(guess: Code) = {
            guesses = Cons(guess, guesses)
            resume(GuessResult(0, 0))
        }
        def showSecretCode() = resume { "😂" }
    }
}

// A `Config` handler, with the default settings: Code length of 5 with 7 different colors.
def defaultConfig[A] { program: => A / Config }: A = {
    try {
        program()
    } with Config {
        def getCodeLength() = resume(5)
        def getNumColors() = resume(7)
    }
}

// Apply handlers to the `gameLoop` to get playing!
def play() = {
    with Formatted::formatting
    with defaultConfig
    with consolePlayer
    with minstd(42)
    with mastermindGameMaster
    gameLoop()
}

def main() = play()
