module src/mefisto

import tty
import src/nonstdlib


def getPinRepresentation(pin: Int): String / Formatted = {
    val escapes = pin match {
        case 0 => ["\u001b[48;5;196m"] // Red background
        case 1 => ["\u001b[48;5;202m"] // Orange background
        case 2 => ["\u001b[48;5;226m", "\u001b[38;5;0m"] // Yellow background, Black foreground
        case 3 => ["\u001b[48;5;46m"]  // Green background
        case 4 => ["\u001b[48;5;51m"]  // Cyan background
        case 5 => ["\u001b[48;5;33m"]  // Blue background
        case 6 => ["\u001b[48;5;93m"]  // Purple background
        case 7 => ["\u001b[48;5;201m"] // Magenta background
        case 8 => ["\u001b[48;5;250m", "\u001b[38;5;0m"] // Light gray background, Black foreground
        case 9 => ["\u001b[48;5;240m"] // Dark gray background
        case _ => Nil()
    }

    if (escapes.nonEmpty && escapes.all{ x => do supportsEscape(x) }) {
        escapes.join("") ++ pin.show ++ "\u001b[0m"
    } else {
        pin.show
    }
}

// Represents a combination of pins, i.e. the secret code or a guess of it.
record Code(
    pins: List[Int]
)

def show(c: Code) = c match {
    case Code(pins) => "[" ++ pins.map{x => x.getPinRepresentation}.join(", ") ++ "]"
}

// Represents the result of a guess:
// -> Number of pins that are in the correct position
// -> Number of pins that have the right color but are placed incorrectly
record GuessResult(
    correctPos: Int,
    incorrectPos: Int
)

def show(gr: GuessResult) = gr match {
    case GuessResult(correctPos, incorrectPos) => "Correct: " ++ correctPos.show ++ ", Wrong position: " ++ incorrectPos.show
}

interface GameMaster {
    def guessResult(guess: Code): GuessResult
    def showSecretCode(): String / Formatted
}

interface Player {
    def makeGuess(): Code
    def showBoard(code: String, attempts: List[(Code, GuessResult)]): Unit / Formatted
}

def gameLoop(): Unit / { Formatted, Player, GameMaster } = {
    var guesses: List[(Code, GuessResult)] = Nil()
    val secretCode = do showSecretCode()

    while (true) {
        do showBoard(secretCode, guesses.reverse)
        val guess = do makeGuess()
        val result = do guessResult(guess)
        guesses = Cons((guess, result), guesses)
    }
}

def consolePlayer[A] { program: => A / Player }: A = {
    try {
        program()
    } with Player {
        def makeGuess() = {
            val guess = { 
                with on[Failure].retry() { msg => { println("Invalid input: " ++ msg) } }
                print("Please enter your guess: ")
                val input = readln().split("").map{x => x.toIntWithException()}
                val inputSize = input.size()
                if (inputSize != 5)
                    do raise(Failure(), "You entered " ++ inputSize.show ++ " pins, but you need to guess " ++ 5.show ++ "!")
                input
            }
            resume(Code(guess))
        }

        def showBoard(code: String, attempts: List[(Code, GuessResult)]) = {
            resume {
                println("+-----------------------------------+")
                println("|                                   |")
                println("|   Secret Code:  " ++ code.show() ++ "   |")
                println("|                                   |")
                attempts.list::foreachIndex { (i, attempt) => attempt match {
                    case (guess, result) => println("|     Attempt " ++ (i + 1).show ++ ":  " ++ guess.show ++ " - " ++ result.show ++ "  |")
                }}
                println("|                                   |")
                println("+-----------------------------------+")
            }
        }
    }
}

def codeGuessResult(code: Code, guess: Code): GuessResult = {
    var correctPos = 0
    var incorrectPos = 0 // TODO

    code.pins.zip(guess.pins).foreach { case (c, g) =>
        if (c == g) correctPos += 1
    }

    GuessResult(correctPos, incorrectPos)
}

def deterministicGameMaster[A](code: Code) { program: => A / GameMaster }: A = {
    try {
        program()
    } with GameMaster {
        def guessResult(guess: Code) = resume(codeGuessResult(code, guess))
        def showSecretCode() = resume { code.show() }
    }
}


def play() = {
    with Formatted::formatting
    with consolePlayer
    with deterministicGameMaster(Code([1, 2, 3, 4, 5]))
    gameLoop()
}

def main() = play()
