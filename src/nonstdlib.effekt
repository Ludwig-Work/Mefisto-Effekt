module src/nonstdlib

// This file contains some very generic functionality, part of which I could imagine as stdlib functions
// in the future. For the time being, this is mostly about converting between `Exception` and `fail`
// (I don't really see any advantage in having the `fail` effect at all tbh, Exceptions seem just more powerful with
// the `on` handlers and the attached messages, so why maintain both?)

import partial
import exception

// ========== Retry operations for failure and exceptions ==========

/// Handle the fail effect by running the onFailure program, then trying the program again.
/// This is repeated until the fail doesn't occur any longer.
def retryUntilSuccess[A] {onFailure: => Unit} { program: => A / fail }: A = {
    try { program() } with fail {
        onFailure()
        retryUntilSuccess {onFailure} {program}
    }
}

/// Handle the exception by running the onException program, then trying the program again.
/// This is repeated until the Exception doesn't occur any longer.
def retryUntilSuccess[E, A] {onException: String => Unit} { program: => A / Exception[E] }: A = {
    try { program() } with Exception[E] {
        def raise(e, msg) = {
            onException(msg)
            retryUntilSuccess {onException} {program}
        }
    }
}

/// Partial application of the above function with `on` proxy.
def retry[E, A](proxy: on[E]) {onException: String => Unit} { program: => A / Exception[E] }: A =
    retryUntilSuccess {onException} {program}




// ========== Conversion between failure and exceptions ==========

/// Convert an exception into a failure
def failOn[E, A] { program: => A / Exception[E] }: A / fail = {
    try { program() } with Exception[E] {
        def raise(e, msg) = do fail()
    }
}

/// Partial application of the above function with `on` proxy.
def fail[E, A](proxy: on[E]) { program: => A / Exception[E] }: A / fail =
    failOn { program }


/// Convert a failure into an exception
def failureToException[E, A](e: E, msg: String) { program: => A / fail }: A / Exception[E] = {
    try { program() } with fail {
        do raise(e, msg)
    }
}



// ========== List functions ==========

/// Computes a list of distinct elements of the list l, according to equality comparator eq.
/// In case of multiple occurrences of a value, the last one is kept.
///
/// O(N²).
def distinct[A](l: List[A]) { eq: (A, A) => Bool }: List[A] = l match {
    case Nil()       => Nil()
    case Cons(x, xs) => if (xs.contains(x) { eq }) {
        distinct(xs) { eq }
    } else {
        Cons(x, distinct(xs) { eq })
    }
}



// ========== Specific implementations of generic functions for certain concrete types / functions ==========

/// Computes a list of distinct elements of the list l.
///
/// O(N²).
def distinct(l: List[Int]): List[Int] = distinct(l) { (x, y) => x == y }

/// Check if the list contains the given `element`.
///
/// O(N)
def contains(l: List[Int], element: Int): Bool = contains(l, element) { (x, y) => x == y }

/// Count how many times the given element is contained in the list.
///
/// O(N)
def count(l: List[Int], element: Int): Int = count(l) { x => x == element }

/// Adaptation of the string::toInt function that uses an exception with a message instead of a failure
def toIntWithException(s: String) =
    failureToException(WrongFormat(), "Could not convert string to int: \"" ++ s ++ "\"") { s.toInt }
