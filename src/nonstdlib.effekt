module src/nonstdlib

// This file contains some very generic functionality, part of which I could imagine as stdlib functions
// in the future. For the time being, this is mostly about converting between `Exception` and `fail`
// (I don't really see any advantage in having the `fail` effect at all tbh, Exceptions seem just more powerful with
// the `on` handlers and the attached messages, so why maintain both?)

import partial
import exception

// ========== Retry operations for failure and exceptions ==========

/// Handle the fail effect by running the onFailure program, then trying the program again.
/// This is repeated until the fail doesn't occur any longer.
def retryUntilSuccess[A] {onFailure: => Unit} { program: => A / fail }: A = {
    try { program() } with fail {
        onFailure()
        retryUntilSuccess {onFailure} {program}
    }
}

/// Handle the exception by running the onException program, then trying the program again.
/// This is repeated until the Exception doesn't occur any longer.
def retryUntilSuccess[A, E] {onException: String => Unit} { program: => A / Exception[E] }: A = {
    try { program() } with Exception[E] {
        def raise(e, msg) = {
            onException(msg)
            retryUntilSuccess {onException} {program}
        }
    }
}

/// Partial application of the above function with `on` proxy.
def retry[A, E](proxy: on[E]) {onException: String => Unit} { program: => A / Exception[E] }: A =
    retryUntilSuccess {onException} {program}




// ========== Conversion between failure and exceptions ==========

/// Convert an exception into a failure
def failOn[A, E] { program: => A / Exception[E] }: A / fail = {
    try { program() } with Exception[E] {
        def raise(e, msg) = do fail()
    }
}

/// Partial application of the above function with `on` proxy.
def fail[A, E](proxy: on[E]) { program: => A / Exception[E] }: A / fail =
    failOn { program }


/// Convert a failure into an exception
def failureToException[A, E](e: E, msg: String) { program: => A / fail }: A / Exception[E] = {
    try { program() } with fail {
        do raise(e, msg)
    }
}


// ========== "choice" effekt (inspired by "flip" from lectures) ==========

/// Effect to get an integer from 0 to inclusiveMax.
/// The max is inclusive purely for consistency with randomInt
/// (which I dislike, I have never seen the max being inclusive in any other language...)
effect choice(inclusiveMax: Int): Int

/// Handler for the choice effect, that builds a flat list of the results for all possible choices.
def allChoices { program: => Unit / choice }: Unit = {
    try {
        program()
    } with choice { maxInclusive =>
        each(0, maxInclusive + 1) { i => resume(i) }
    }
}


// ========== List functions ==========

/// Computes a list of distinct elements of the list l, according to equality comparator eq.
/// In case of multiple occurrences of a value, the last one is kept.
///
/// O(N²).
def distinct[A](l: List[A]) { eq: (A, A) => Bool }: List[A] = l match {
    case Nil()       => Nil()
    case Cons(x, xs) => if (xs.contains(x) { eq }) {
        distinct(xs) { eq }
    } else {
        Cons(x, distinct(xs) { eq })
    }
}

/// Compares two lists for element-wise equality, according to the equality comparator eq.
/// (Advantage of having this: It works in the LLVM backend, unlike genericEquals)
///
/// O(N)
def equals[A](left: List[A], right: List[A]) { eq: (A, A) => Bool }: Bool = {
    def go(zipped: List[OneOrBoth[A, A]]): Bool = zipped match {
        case Nil() => true // Both lists are empty
        case Cons(head, tail) => head match {
            case This(_) => false // left is longer than right
            case That(_) => false // right is longer than left
            case Both(a, b) => eq(a, b) && go(tail)
        }
    }

    go(left.zipLongest(right))
}

// An equality `assert` for lists based on this should also be provided, but since I'm testing everything in this file,
// that'd mean that I'd have to write assertions that my assertions work correctly... Which I think puts me too
// far off the track of what I'm supposed to be doing, writing Mefisto ;)
// Likewise, an assertEqual tailored for lists of primitive types (like List[Int], etc.) should also be done below for completeness...
// What we have with this:
// > assertEqual(['a', 'b', 'c'], ['a', 'b', 'c'], "...") { (left, right) => left.equals(right) { (x, y) => x == y } }
// vs. What we could have:
// > assert(['a', 'b', 'c'], ['a', 'b', 'c'], "...")



// ========== Specific implementations of generic functions for certain concrete types / functions ==========
//
// I mainly wrote specific implementations for Ints, but for completeness, the remaining primitive types should
// deserve their special implementations using default equality as well!

/// Computes a list of distinct elements of the list l.
///
/// O(N²).
def distinct(l: List[Int]): List[Int] = distinct(l) { (x, y) => x == y }

/// Compares two list for element-wise equality.
///
/// O(N)
def equals(left: List[Int], right: List[Int]) = equals(left, right) { (x, y) => x == y }

/// Check if the list contains the given `element`.
///
/// O(N)
def contains(l: List[Int], element: Int): Bool = contains(l, element) { (x, y) => x == y }

/// Count how many times the given element is contained in the list.
///
/// O(N)
def count(l: List[Int], element: Int): Int = count(l) { x => x == element }

/// Adaptation of the string::toInt function that uses an exception with a message instead of a failure
def toIntWithException(s: String) =
    failureToException(WrongFormat(), "Could not convert string to int: \"" ++ s ++ "\"") { s.toInt }
